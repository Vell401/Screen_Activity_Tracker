{
  "manifest_version": 3,
  "name": "Screen Activity Tracker — Browser Connector",
  "version": "1.2.0",
  "description": "Передаёт URL и заголовок активной вкладки в приложение Screen Activity Tracker по локальному адресу 127.0.0.1. Ничего не отправляет в интернет.",
  "key": "",
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Screen Activity Tracker"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
